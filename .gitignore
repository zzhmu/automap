# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd

# ---- 生成产物 ----
# 地图与预览图都能用种子复现，不入库；要留样本把 out/ 里的文件复制出来再 git add -f
out/
generated/
backups/
*.bak

# ---- MPQ 解包的临时文件 ----
# inspect_*.py 会把 war3map.* 解到这里，是中间产物
bin/Work/

# ---- tools/_tmp：脚本保留，二进制中间产物忽略 ----
tools/_tmp/**/*.w3x
tools/_tmp/**/*.w3m
tools/_tmp/**/*.w3e
tools/_tmp/**/*.doo
tools/_tmp/**/*.wpm
tools/_tmp/**/*.shd
tools/_tmp/**/*.mmp
tools/_tmp/**/*.blp
tools/_tmp/**/*.png
tools/_tmp/**/*.j

# ---- 系统垃圾 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 开源发布新增（2026-09-17）----
# 受版权保护的资产：官方地图模板（Blizzard）与第三方工具（Ladik's MPQ Editor）
# 不入库。README 有提取/下载方法。
template/
bin/
*.w3m
*.w3x
*.exe
*.dll

# AI 协作工作记忆（个人痕迹，与项目本体无关）
.workbuddy/

# 一次性分析脚本的二进制中间产物已在上方按扩展名忽略；_tmp 里未跟踪的
# 顶层杂物目录（解包产物）也全部忽略，只保留已提交的 .py/.txt 统计脚本
tools/_tmp/*
!tools/_tmp/*.py
!tools/_tmp/*.txt
